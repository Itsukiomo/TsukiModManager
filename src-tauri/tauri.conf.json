{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsuki Mod Manager",
  "version": "2.0.1",
  "identifier": "com.jeffe.tsukimodmanagerapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tsuki Mod Manager",
        "width": 1500,
        "height": 900,
        "decorations": false,
        "visible": false,
        "center": true,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Tsuki Mod Manager/profile-data/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/lunar-v2/32x32.png",
      "icons/lunar-v2/128x128.png",
      "icons/lunar-v2/128x128@2x.png",
      "icons/lunar-v2/icon.icns",
      "icons/lunar-v2/icon.ico"
    ]
  }
}
